# PostgreSQL Database Connection
# For local Docker: postgresql+psycopg://taskflow_user:taskflow_password@localhost:5432/taskflow
# For SQLite (offline dev): sqlite:///./taskflow.db
DATABASE_URL=sqlite:///./taskflow.db

# JWT & Security
JWT_SECRET_KEY=change_this_to_a_super_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL for CORS
FRONTEND_ORIGIN=http://localhost:5173
